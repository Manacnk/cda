#include <iostream>
#include <fstream>
#include <sstream>
#include <string>
#include <vector>
#include <memory>
#include <map>
#include <set>
#include <cctype>
#include <stdexcept>
using namespace std;

// 元素和文本都作为节点保存，保证混合内容的原始顺序。
struct Node {
    string tag, text;
    map<string, string> attrs;
    vector<unique_ptr<Node>> children; // 多叉树；unique_ptr 自动释放内存
};
bool ws(char c) { return isspace(static_cast<unsigned char>(c)) != 0; }
string lower(string s) {
    for (char& c : s) c = static_cast<char>(tolower(static_cast<unsigned char>(c)));
    return s;
}
string normalize(const string& s) {
    string out; bool space = false;
    for (char c : s) {
        if (ws(c)) { space = !out.empty(); continue; }
        if (space) out += ' ';
        out += c; space = false;
    }
    return out;
}
void utf8(string& out, unsigned long x) {
    if (x > 0x10FFFF || (x >= 0xD800 && x <= 0xDFFF) || x == 0) x = 0xFFFD;
    if (x < 0x80) out += static_cast<char>(x);
    else if (x < 0x800) { out += static_cast<char>(0xC0 | (x >> 6)); out += static_cast<char>(0x80 | (x & 63)); }
    else if (x < 0x10000) { out += static_cast<char>(0xE0 | (x >> 12)); out += static_cast<char>(0x80 | ((x >> 6) & 63)); out += static_cast<char>(0x80 | (x & 63)); }
    else { out += static_cast<char>(0xF0 | (x >> 18)); out += static_cast<char>(0x80 | ((x >> 12) & 63)); out += static_cast<char>(0x80 | ((x >> 6) & 63)); out += static_cast<char>(0x80 | (x & 63)); }
}
// 常见命名实体及十进制/十六进制数字实体；未知实体原样保留。
string decode(const string& s) {
    static const map<string, string> entities = { {"amp","&"},{"lt","<"},{"gt",">"},{"quot","\""},{"apos","'"},{"nbsp"," "} };
    string out;
    for (size_t i = 0; i < s.size();) {
        if (s[i] == '&') {
            size_t e = s.find(';', i + 1);
            if (e != string::npos && e - i < 32) {
                string key = s.substr(i + 1, e - i - 1);
                auto it = entities.find(key);
                if (it != entities.end()) { out += it->second; i = e + 1; continue; }
                if (!key.empty() && key[0] == '#') {
                    try {
                        bool hex = key.size() > 1 && (key[1] == 'x' || key[1] == 'X');
                        string digits = key.substr(hex ? 2 : 1); size_t used = 0;
                        unsigned long value = stoul(digits, &used, hex ? 16 : 10);
                        if (used == digits.size() && !digits.empty() && digits[0] != '-' && digits[0] != '+') { utf8(out, value); i = e + 1; continue; }
                    }
                    catch (...) {}
                }
            }
        }
        out += s[i++];
    }
    return out;
}

// 栈记录当前路径，遇到开始标签入栈，结束标签退栈。
unique_ptr<Node> parseHTML(const string& html) {
    auto root = make_unique<Node>(); root->tag = "#document";
    vector<Node*> stack{ root.get() };
    const set<string> voids = { "area","base","br","col","embed","hr","img","input","link","meta","param","source","track","wbr" };
    string low = lower(html);
    size_t i = 0;
    while (i < html.size()) {
        if (stack.back()->tag == "script" || stack.back()->tag == "style") {
            string close = "</" + stack.back()->tag; size_t p = low.find(close, i);
            while (p != string::npos && p + close.size() < html.size() && !ws(html[p + close.size()]) && html[p + close.size()] != '>') p = low.find(close, p + 1);
            if (p == string::npos) break;
            i = p;
        }
        if (html.compare(i, 4, "<!--") == 0) {
            size_t e = html.find("-->", i + 4); i = e == string::npos ? html.size() : e + 3; continue;
        }
        if (html[i] != '<') {
            size_t e = html.find('<', i); if (e == string::npos) e = html.size();
            auto n = make_unique<Node>(); n->tag = "#text"; n->text = html.substr(i, e - i);
            stack.back()->children.push_back(move(n)); i = e; continue;
        }
        // 引号内部的 > 不会结束标签。
        size_t e = i + 1; char quote = 0;
        for (e;e < html.size();++e) {
            char c = html[e];   
            if (quote) { if (c == quote) quote = 0; }
            else if (c == '\'' || c == '"') quote = c;
            else if (c == '>') break;
        }
        if (e == html.size()) break;
        string token = html.substr(i + 1, e - i - 1); i = e + 1;
        size_t p = 0; while (p < token.size() && ws(token[p])) ++p;
        if (p == token.size() || token[p] == '!' || token[p] == '?') continue;
        bool closing = token[p] == '/'; if (closing) ++p;
        size_t start = p;
        while (p < token.size() && !ws(token[p]) && token[p] != '/' && token[p] != '=') ++p;
        string tag = lower(token.substr(start, p - start)); if (tag.empty()) continue;
        if (closing) {
            // 不匹配的结束标签忽略；容忍素材中孤立的 </legend>。
            for (size_t k = stack.size();k > 1;--k) if (stack[k - 1]->tag == tag) { stack.resize(k - 1); break; }
            continue;
        }
        auto n = make_unique<Node>(); n->tag = tag;
        while (p < token.size()) {
            while (p < token.size() && (ws(token[p]) || token[p] == '/')) ++p;
            start = p;
            while (p < token.size() && !ws(token[p]) && token[p] != '=' && token[p] != '/') ++p;
            if (p == start) { if (p < token.size()) ++p; continue; }
            string key = lower(token.substr(start, p - start)), value;
            while (p < token.size() && ws(token[p])) ++p;
            if (p < token.size() && token[p] == '=') {
                ++p; while (p < token.size() && ws(token[p])) ++p;
                if (p < token.size() && (token[p] == '\'' || token[p] == '"')) {
                    char q = token[p++]; start = p; while (p < token.size() && token[p] != q) ++p;
                    value = token.substr(start, p - start); if (p < token.size()) ++p;
                }
                else {
                    start = p; while (p < token.size() && !ws(token[p])) ++p;
                    value = token.substr(start, p - start);
                }
            }
            n->attrs.emplace(key, decode(value));
        }
        Node* ptr = n.get(); stack.back()->children.push_back(move(n));
        size_t last = token.find_last_not_of(" \t\r\n");
        bool selfClose = last != string::npos && token[last] == '/';
        if (!selfClose && !voids.count(tag)) stack.push_back(ptr);
    }
    return root;
}
bool group(const Node& n) {
    auto it = n.attrs.find("role");
    if (it != n.attrs.end()) {
        istringstream words(lower(it->second)); string word;
        while (words >> word) if (word == "rowgroup") return true;
    }
    return n.attrs.count("rowgroup") != 0;
}
// 优先使用 ARIA 索引；不能混用 data-rowindex 的 0 起始编号。
bool indexOf(const Node& n, const string& name, string& value) {
    for (const string& key : { "aria-" + name,name,"data-" + name }) {
        auto it = n.attrs.find(key);
        if (it != n.attrs.end()) { value = it->second; return true; }
    }
    return false;
}
void collectText(const Node& n, string& result) {
    if (n.tag == "script" || n.tag == "style" || n.tag == "template") return;
    if (n.tag == "#text") {
        string part = normalize(decode(n.text));
        if (!part.empty()) { if (!result.empty()) result += ' '; result += part; }
        return;
    }
    for (const auto& c : n.children) collectText(*c, result);
}
string csv(const string& s) {
    string out = "\"";
    for (char c : s) { if (c == '"') out += '"'; out += c; }
    return out + '"';
}
struct Stats { size_t groups = 0, rows = 0, cells = 0, empty = 0; };
void findCols(const Node& n, const string& row, ostream& out, Stats& stats) {
    string value;
    if (group(n) || indexOf(n, "rowindex", value)) return;
    if (indexOf(n, "colindex", value)) {
        string text; collectText(n, text);
        out << csv(row) << ',' << csv(value) << ',' << csv(text) << "\r\n";
        ++stats.cells; if (text.empty()) ++stats.empty;
        return; // 一个单元格只输出一次
    }
    for (const auto& c : n.children) findCols(*c, row, out, stats);
}
void findRows(const Node& n, ostream& out, Stats& stats) {
    if (group(n)) return; // 嵌套 rowgroup 交给外层统一遍历，避免重复
    string row;
    if (indexOf(n, "rowindex", row)) {
        ++stats.rows;
        for (const auto& c : n.children) findCols(*c, row, out, stats);
    }
    for (const auto& c : n.children) findRows(*c, out, stats);
}
void findGroups(const Node& n, ostream& out, Stats& stats) {
    if (group(n)) {
        ++stats.groups;
        for (const auto& c : n.children) findRows(*c, out, stats);
    }
    for (const auto& c : n.children) findGroups(*c, out, stats);
}
int main(int argc, char* argv[]) {
    try {
        string input = argc > 1 ? argv[1] : "q.html", output = argc > 2 ? argv[2] : "output.csv";
        if (input == output) throw runtime_error("Input and output must differ.");
        ifstream in(input, ios::binary);
        if (!in) throw runtime_error("Cannot open input: " + input);
        ostringstream buffer; buffer << in.rdbuf();
        if (in.bad()) throw runtime_error("Input read failed.");
        auto root = parseHTML(buffer.str());
        ofstream out(output, ios::binary);
        if (!out) throw runtime_error("Cannot open output: " + output);
        out << "\xEF\xBB\xBF"; // UTF-8 BOM，方便 Excel 识别中文/日文
        out << "rowindex,colindex,text\r\n";
        Stats stats; findGroups(*root, out, stats); out.flush();
        if (!out) throw runtime_error("Output write failed.");
        cout << "Groups=" << stats.groups << ", Rows=" << stats.rows << ", Cells=" << stats.cells << ", Empty=" << stats.empty << "\nSaved: " << output << '\n';
    }
    catch (const exception& e) { cerr << e.what() << '\n'; return 1; }
}
